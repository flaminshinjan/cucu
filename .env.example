# =================================================================
# Content Agent Demo — environment variables
# Every adapter falls back to a realistic mock when its key is absent.
# Add the keys you have; leave the rest blank.
# =================================================================

# ---- LLM (Claude) ----------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5

# ---- Research --------------------------------------------------------------
TAVILY_API_KEY=

# ---- Voice (smallest TTS — OpenAI tts-1 ~ $0.015 / 1k chars) ----------------
# Without this, the UI falls back to the browser's built-in SpeechSynthesis.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ---- Avatar render ---------------------------------------------------------
# Provider can be: heygen | did | mock
#
# HeyGen note: their "API credits" pool is sold SEPARATELY from the plan/subscription.
# A $79 Studio plan does NOT include API credits. Buy them as an add-on or use D-ID.
#
# D-ID note: $5.90/mo Lite plan includes API access. 10 credits/mo, $0.10/credit overage.
# Simpler pricing than HeyGen. Recommended.
AVATAR_PROVIDER=did
HEYGEN_API_KEY=
DID_API_KEY=

# ---- Images (Flux Schnell on Replicate) ------------------------------------
REPLICATE_API_TOKEN=

# ---- Storage (Supabase) ----------------------------------------------------
# When unset, falls back to local filesystem in ./data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App config ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Content Agent Demo
